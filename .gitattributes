# NOTE: `.gitattributes` does NOT stop git from tracking files.
# It only affects attributes (e.g., GitHub Linguist language stats / generated files).

# Mark example/scraped HTML artifacts as generated so GitHub:
# - excludes them from language stats
# - collapses them in PR diffs (generated files can be hidden)

index.html text eol=lf

tests/fixtures/** linguist-generated=true
assets/vendor/pdfjs-*/*.mjs text eol=lf linguist-vendored=true
assets/vendor/pdfjs-*/LICENSE text eol=lf linguist-vendored=true
assets/vendor/pdfjs-*/README.md text eol=lf linguist-vendored=true
assets/vendor/fontawesome-*/*.txt text eol=lf linguist-vendored=true
assets/vendor/fontawesome-*/**/*.css text eol=lf linguist-vendored=true
assets/vendor/fontawesome-*/**/*.woff2 -text linguist-vendored=true
assets/vendor/fontawesome-*/**/*.ttf -text linguist-vendored=true
assets/vendor/fontawesome-*/README.md text eol=lf linguist-vendored=true
assets/vendor/inter-*/LICENSE text eol=lf linguist-vendored=true
assets/vendor/inter-*/**/*.css text eol=lf linguist-vendored=true
assets/vendor/inter-*/**/*.woff2 -text linguist-vendored=true
assets/vendor/inter-*/README.md text eol=lf linguist-vendored=true
